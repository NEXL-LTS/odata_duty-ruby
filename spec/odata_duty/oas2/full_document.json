        },
        "nickname":{
          "type":"string",
          "x-nullable":true
        },
        "status":{
          "$ref":"#/definitions/FullDocStatus",
          "x-nullable":true
        },
        "badge":{
          "$ref":"#/definitions/FullDocBadge",
