          "properties":{
            "code":{
              "type":"string",
              "description":"A service-defined error code."
            },
            "message":{
              "type":"string",
              "description":"A human-readable message."
            },
            "target":{
              "type":"string",
              "description":"The target of the error.",
              "x-nullable":true
            }
          }
        }
      }
    },
